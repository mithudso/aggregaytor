{
  "name": "aggregaytor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "clean": "pnpm -r exec rm -rf dist",
    "index:check": "node scripts/check-doc-indexes.mjs",
    "index:semantic": "python3 scripts/semantic_indexer.py",
    "index:watch": "./scripts/watch_and_index.sh",
    "registry": "node scripts/gen-method-registry.mjs",
    "registry:check": "node scripts/gen-method-registry.mjs --check"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.4.0",
    "vitest": "^3.1.0",
    "eslint": "^10.9.1",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "prettier": "^3.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}