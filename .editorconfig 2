# EditorConfig — https://editorconfig.org
# Inferred from existing sources: 2-space TS/JS/JSON, LF, UTF-8.
# No Prettier config file exists in this repo (prettier is a devDependency only).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
